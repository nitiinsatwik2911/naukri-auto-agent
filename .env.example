# Naukri Auto-Apply Bot Configuration
# Copy this file to .env and fill in your details
# NEVER commit .env to git (it's in .gitignore)

# Your Naukri.com login credentials
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_password

# Your personal details (used for custom first/last name fields on some applications)
FIRSTNAME=YourFirstName
LASTNAME=YourLastName

# Job search keywords (comma-separated, e.g., "python developer, data analyst")
KEYWORDS=python developer, data analyst, software engineer

# Location filter (leave empty for all locations, or specify a city)
LOCATION=bangalore

# Number of search result pages to scrape per keyword (default: 2)
# Each keyword opens PAGES_PER_KEYWORD tabs simultaneously
PAGES_PER_KEYWORD=2

# Maximum number of jobs to apply per run
# Naukri typically allows ~100 applications per day
MAX_APPLICATIONS=50

# Browser configuration (only needed if NOT using webdriver-manager auto-detection)
# For Edge: path to msedgedriver.exe
# EDGE_DRIVER_PATH=C:\path\to\msedgedriver.exe
# For Firefox: path to Firefox profile root directory
# FIREFOX_PROFILE_PATH=C:\path\to\firefox\profile
# Profile used by answer_bot.py for screening questions
FULL_NAME=Your Full Name
PROFILE_EMAIL=you@example.com
PROFILE_PHONE=0000000000
PROFILE_CITY=YourCity
PROFILE_LINKEDIN=https://linkedin.com/in/your-id
PROFILE_COMPANY=Current Company
PROFILE_DESIGNATION=Current Title
PROFILE_DEGREE=B.Tech
PROFILE_BRANCH=Your Branch
PROFILE_COLLEGE=Your College
PROFILE_CGPA=0.0
TOTAL_EXPERIENCE=4
# CURRENT_CTC, EXPECTED_CTC, NOTICE_PERIOD, IMMEDIATE_JOINER, WILLING_TO_RELOCATE,
# WILLING_TO_WORK_FROM_OFFICE, AUTHORIZED_TO_WORK_IN_INDIA are also read if set

# Years of experience per skill (skill:years, comma-separated); used for 'experience in X' questions
SKILL_YEARS=python:4,selenium:4,docker:2

# --- Files / folders ---
# All CSV output (answers, results, job history, debug pages) goes in this folder
DATA_DIR=data
RESUME_FILE=config/resume.txt

# --- Limits and matching (used by the bots) ---
# Jobs ticked per batch in Naukri-Recommended.py
MAX_SELECT=5
# Min similarity (0-1) for reusing a saved answer: answer_bot.py / Naukri-Recommended.py
SAVED_ANSWER_CUTOFF=0.95
RECOMMENDED_FUZZY_THRESHOLD=0.72
# Min similarity (0-1) for matching an answer to a radio/select option
OPTION_MATCH_CUTOFF=0.7

# --- LLM fallback for unknown screening questions (needs the `claude` CLI) ---
LLM_MODEL=haiku
LLM_TIMEOUT=90
# Notice period the LLM may assume when NOTICE_PERIOD is not set
LLM_DEFAULT_NOTICE_PERIOD=30 days

# --- Filter mode: python cli.py filter ---
# Paste a Naukri search URL with your filters applied (copy it from the browser address bar).
# The bot logs in, opens this URL, then reads every page of results from Naukri's search API.
FILTER_URL=https://www.naukri.com/ai-engineer-jobs?sort=r&wfhType=0&wfhType=3&experience=4&functionAreaIdGid=5&cityTypeGid=17&ctcFilter=25to50&ugTypeGid=12&jobAge=15&k=ai%20engineer
# Tracking parameters removed from the URL (comma-separated)
FILTER_DROP_PARAMS=nignbevent_src

# Safety cap on result pages read (it stops earlier when a page has no jobs)
FILTER_MAX_PAGES=10
# Naukri site and search-API details used to read the results
NAUKRI_BASE_URL=https://www.naukri.com
FILTER_API_PATH=/jobapi/v3/search
# Seconds to wait for the search page to make its API call
FILTER_API_WAIT=7
# Request headers copied from the page's own API call
FILTER_API_HEADERS=appid,systemid,clientid,gid,nkparam,content-type,accept
