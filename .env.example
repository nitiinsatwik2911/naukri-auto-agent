# Naukri Auto-Apply Agent configuration
# Copy this file to .env and fill in your details:   copy .env.example .env
# NEVER commit .env to git (it is in .gitignore).
# All settings live here: the Python code has no built-in defaults, and numeric
# settings (marked "required") must be set or the bot stops with a message.

# =============================================================================
# 1. Naukri account
# =============================================================================
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_password
NAUKRI_BASE_URL=https://www.naukri.com

# =============================================================================
# 2. Run modes
#    python cli.py search        keyword search      (uses section 2a)
#    python cli.py filter        your filtered URL   (uses section 2b)
#    python cli.py recommended   recommended feed    (uses section 2c)
# =============================================================================

# Maximum applications per run (Naukri allows ~100/day). Required.
MAX_APPLICATIONS=50

# --- 2a. Keyword search ---
# Job keywords, comma-separated
KEYWORDS=python developer, data analyst, software engineer
# City (leave empty for all locations)
LOCATION=bangalore
# Result pages opened per keyword; each page is one browser tab. Required.
PAGES_PER_KEYWORD=2

# --- 2b. Filter mode ---
# Paste a Naukri search URL with your filters applied (copy it from the address bar).
# The bot logs in, opens it, then reads every result page from Naukri's search API.
FILTER_URL=https://www.naukri.com/ai-engineer-jobs?sort=r&experience=4&cityTypeGid=17&ctcFilter=25to50&jobAge=15&k=ai%20engineer
# Tracking parameters removed from FILTER_URL (comma-separated)
FILTER_DROP_PARAMS=nignbevent_src
# Safety cap on result pages read (it stops earlier when a page has no jobs). Required.
FILTER_MAX_PAGES=10
# Seconds to wait for the search page to make its API call. Required.
FILTER_API_WAIT=7
# Search API path and the request headers copied from the page's own call.
# Only change these if Naukri changes its API.
FILTER_API_PATH=/jobapi/v3/search
FILTER_API_HEADERS=appid,systemid,clientid,gid,nkparam,content-type,accept

# --- 2c. Recommended mode ---
# Jobs ticked per batch. Required.
MAX_SELECT=5

# =============================================================================
# 3. Files and folders
# =============================================================================
# All generated files go here: application_answers.csv, naukriapplied.csv,
# job_history.csv and debug_pages/
DATA_DIR=data
# Resume used by the LLM fallback (copy config/resume.example.txt to this path)
RESUME_FILE=config/resume.txt

# =============================================================================
# 4. Browser
# =============================================================================
# Path to msedgedriver.exe. Leave empty to auto-download it with webdriver-manager.
# EDGE_DRIVER_PATH=C:\path\to\msedgedriver.exe

# =============================================================================
# 5. Your profile (used to answer screening questions)
# =============================================================================
FULL_NAME=Your Full Name
FIRSTNAME=YourFirstName
LASTNAME=YourLastName
PROFILE_EMAIL=you@example.com
PROFILE_PHONE=0000000000
PROFILE_CITY=YourCity
PROFILE_LINKEDIN=https://linkedin.com/in/your-id
PROFILE_COMPANY=Current Company
PROFILE_DESIGNATION=Current Title
PROFILE_DEGREE=B.Tech
PROFILE_BRANCH=Your Branch
PROFILE_COLLEGE=Your College
PROFILE_CGPA=0.0
TOTAL_EXPERIENCE=4

# Years of experience per skill (skill:years, comma-separated).
# Used for "years of experience in X" questions; the longest matching skill wins.
SKILL_YEARS=python:4,selenium:4,docker:2

# Not on a resume. Leave a value empty and the bot falls back to the LLM, or logs
# the question as "unanswered" for you to fill in data/application_answers.csv.
CURRENT_CTC=
EXPECTED_CTC=
NOTICE_PERIOD=
# yes / no
IMMEDIATE_JOINER=
WILLING_TO_RELOCATE=
WILLING_TO_WORK_FROM_OFFICE=
AUTHORIZED_TO_WORK_IN_INDIA=

# =============================================================================
# 6. Answer matching (similarity cut-offs between 0 and 1). All required.
# =============================================================================
# Reuse a saved answer only if the question is at least this similar
SAVED_ANSWER_CUTOFF=0.95
# Same, for the recommended mode
RECOMMENDED_FUZZY_THRESHOLD=0.72
# Match an answer to a radio / dropdown option
OPTION_MATCH_CUTOFF=0.7

# =============================================================================
# 7. LLM fallback for questions with no saved answer or rule
#    Uses an AI command-line tool that is installed and logged in on this machine.
# =============================================================================
# Providers to try, in order, until one answers. Use "claude", "copilot", or both
# ("claude,copilot"). Leave empty (or "none") to turn the LLM off: unknown questions
# are then saved as "unanswered" in data/application_answers.csv for you to fill in.
LLM_PROVIDER=claude
# The command for each provider. {prompt} is replaced by the question prompt; a command
# without {prompt} receives the prompt on stdin. Run `claude --help` / `copilot --help`
# to check the flags for your installed version. Add LLM_<NAME>_COMMAND for any other tool.
LLM_CLAUDE_COMMAND=claude -p --model haiku
LLM_COPILOT_COMMAND=copilot -s -p {prompt}
# Seconds before an LLM call is abandoned. Required.
LLM_TIMEOUT=90
# Notice period the LLM may assume when NOTICE_PERIOD is empty
LLM_DEFAULT_NOTICE_PERIOD=30 days
